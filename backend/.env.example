# GCP Configuration
GOOGLE_CLOUD_PROJECT=playgroundai-470111

# Service Configuration
PORT=8080
NODE_ENV=development

# GCP Resource Names (provisioned by infra/setup_gcp.sh)
FIRESTORE_DATABASE_ID=yaaralabs-playground
GCS_BUCKET_NAME=yaaralabs-playground-470111-data
PUBSUB_TOPIC_NAME=yaaralabs-train-jobs
PUBSUB_SUBSCRIPTION_NAME=yaaralabs-trainer-sub

# CORS Configuration (comma-separated, added to localhost defaults)
CORS_ORIGIN=http://localhost:3000

# Security
JWT_SECRET=

# Admin area (/admin). ADMIN_JWT_SECRET signs admin login tokens: 32+ random characters, e.g.
#   python -c "import secrets; print(secrets.token_hex(32))"
# Admin login is off while it is empty. ADMIN_SIGNUP_CODE is required to create an admin account;
# leave it empty to turn signup off.
ADMIN_JWT_SECRET=
ADMIN_JWT_EXPIRE_MINUTES=480
ADMIN_SIGNUP_CODE=

# Google Custom Search API (Image Search)
GOOGLE_API_KEY=
GOOGLE_CSE_ID=

# BrightData API Keys
BRIGHTDATA_API_TOKEN=

# OpenFIGI (ISIN lookup for ISINs not in NSE's equity list). Optional: free key from openfigi.com
OPENFIGI_API_KEY=
