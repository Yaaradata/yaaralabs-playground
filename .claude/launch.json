{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "--prefix",
        "frontend",
        "run",
        "dev"
      ],
      "port": 3000
    },
    {
      "name": "backend",
      "runtimeExecutable": "backend/.venv/Scripts/python.exe",
      "runtimeArgs": [
        "-m",
        "uvicorn",
        "app.main:app",
        "--app-dir",
        "backend",
        "--env-file",
        "backend/.env",
        "--host",
        "127.0.0.1",
        "--port",
        "8765",
        "--reload",
        "--reload-dir",
        "backend/app"
      ],
      "port": 8765,
      "url": "http://localhost:8765"
    }
  ]
}
